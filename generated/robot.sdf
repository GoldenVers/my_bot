<sdf version='1.7'>
  <model name='robot'>
<plugin
    filename="libignition-gazebo-diff-drive-system.so"
    name="ignition::gazebo::systems::DiffDrive">

    <!-- Wheel Information -->
    <left_joint>left_wheel_joint</left_joint>
    <right_joint>right_wheel_joint</right_joint>
    <wheel_separation>0.35</wheel_separation>
    <wheel_radius>0.05</wheel_radius> <!-- Use radius instead of diameter -->

    <!-- Command and Odometry Topics -->
    <topic>cmd_vel</topic> <!-- Topic for velocity commands -->
    <odom_topic>odom</odom_topic> <!-- Topic for odometry data -->

    <!-- Frames -->
    <odometry_frame>odom</odometry_frame> <!-- Frame for odometry -->
    <robot_base_frame>base_link</robot_base_frame> <!-- Base frame of the robot -->

    <!-- Odometry Settings -->
    <publish_odom>true</publish_odom> <!-- Publish odometry data -->
    <publishOdomTF>true</publishOdomTF><!-- Publish wheel TF -->
    <odom_publish_frequency>30</odom_publish_frequency> <!-- Frequency of odometry updates -->
    

    <!-- Limits -->
    <max_wheel_torque>10.0</max_wheel_torque> <!-- Maximum wheel torque -->
    <max_wheel_acceleration>0.33</max_wheel_acceleration> <!-- Maximum wheel acceleration -->
</plugin>

<!--moving the robot using the keyboard-->

<!-- Moving Forward-->
<plugin filename="libignition-gazebo-triggered-publisher-system.so"
        name="ignition::gazebo::systems::TriggeredPublisher">
    <input type="ignition.msgs.Int32" topic="/keyboard/keypress">
        <match field="data">16777237</match>
    </input>
    <output type="ignition.msgs.Twist" topic="/cmd_vel">
        linear: {x: -2}, angular: {z: 0.0}
    </output>
</plugin>

<!-- Moving Backward -->

<plugin filename="libignition-gazebo-triggered-publisher-system.so"
        name="ignition::gazebo::systems::TriggeredPublisher">
    <input type="ignition.msgs.Int32" topic="/keyboard/keypress">
        <match field="data">16777235</match>
    </input>
    <output type="ignition.msgs.Twist" topic="/cmd_vel">
        linear: {x: 2}, angular: {z: 0.0}
    </output>
</plugin>

<!-- Moving Left --> 

<plugin filename="libignition-gazebo-triggered-publisher-system.so"
        name="ignition::gazebo::systems::TriggeredPublisher">
    <input type="ignition.msgs.Int32" topic="/keyboard/keypress">
        <match field="data">16777234</match>
    </input>
    <output type="ignition.msgs.Twist" topic="/cmd_vel">
        linear: {x: 0}, angular: {z: 2}
    </output>
</plugin>

<!-- Moving Right -->

<plugin filename="libignition-gazebo-triggered-publisher-system.so"
        name="ignition::gazebo::systems::TriggeredPublisher">
    <input type="ignition.msgs.Int32" topic="/keyboard/keypress">
        <match field="data">16777236</match>
    </input>
    <output type="ignition.msgs.Twist" topic="/cmd_vel">
        linear: {x: 0}, angular: {z: -2}
    </output>
</plugin>




    <link name='base_link'>
      <inertial>
        <pose>0.065 0 0.0625 0 -0 0</pose>
        <mass>0.6</mass>
        <inertia>
          <ixx>0.00525625</ixx>
          <ixy>0</ixy>
          <ixz>0.0005625</ixz>
          <iyy>0.00593125</iyy>
          <iyz>0</iyz>
          <izz>0.008275</izz>
        </inertia>
      </inertial>
      <collision name='base_link_fixed_joint_lump__chassis_collision'>
        <pose>0.05 0 0.075 0 -0 0</pose>
        <geometry>
          <box>
            <size>0.3 0.3 0.15</size>
          </box>
        </geometry>
        <surface>
          <contact>
            <ode/>
          </contact>
          <friction>
            <ode/>
          </friction>
        </surface>
      </collision>
      <collision name='base_link_fixed_joint_lump__caster_wheel_collision_1'>
        <pose>0.14 0 0 0 -0 0</pose>
        <geometry>
          <sphere>
            <radius>0.05</radius>
          </sphere>
        </geometry>
        <surface>
          <contact>
            <ode/>
          </contact>
          <friction>
            <ode>
              <mu>0.001</mu>
              <mu2>0.001</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name='base_link_fixed_joint_lump__chassis_visual'>
        <pose>0.05 0 0.075 0 -0 0</pose>
        <geometry>
          <box>
            <size>0.3 0.3 0.15</size>
          </box>
        </geometry>
        <material>
          <ambient>1 1 1 1</ambient>  <!-- White color -->
          <diffuse>1 1 1 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>
      <visual name='base_link_fixed_joint_lump__caster_wheel_visual_1'>
        <pose>0.14 0 0 0 -0 0</pose>
        <geometry>
          <sphere>
            <radius>0.05</radius>
          </sphere>
        </geometry>
        <material>
          <ambient>0 0 0 1</ambient>  <!-- Black color -->
          <diffuse>0 0 0 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>

      </visual>
    </link>
    <joint name='left_wheel_joint' type='revolute'>
      <pose relative_to='base_link'>0 0.175 0 -1.5708 0 0</pose>
      <parent>base_link</parent>
      <child>left_wheel</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1e+16</lower>
          <upper>1e+16</upper>
        </limit>
        <dynamics>
          <spring_reference>0</spring_reference>
          <spring_stiffness>0</spring_stiffness>
        </dynamics>
      </axis>
    </joint>
    <link name='left_wheel'>
      <pose relative_to='left_wheel_joint'>0 0 0 0 -0 0</pose>
      <inertial>
        <pose>0 0 0 0 -0 0</pose>
        <mass>0.1</mass>
        <inertia>
          <ixx>7.58333e-05</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>7.58333e-05</iyy>
          <iyz>0</iyz>
          <izz>0.000125</izz>
        </inertia>
      </inertial>
      <collision name='left_wheel_collision'>
        <pose>0 0 0 0 -0 0</pose>
        <geometry>
          <cylinder>
            <length>0.04</length>
            <radius>0.05</radius>
          </cylinder>
        </geometry>
        <surface>
          <contact>
            <ode/>
          </contact>
          <friction>
            <ode/>
          </friction>
        </surface>
      </collision>
      <visual name='left_wheel_visual'>
        <pose>0 0 0 0 -0 0</pose>
        <geometry>
          <cylinder>
            <length>0.04</length>
            <radius>0.05</radius>
          </cylinder>
        </geometry>
        <material>
          <ambient>0 0 1 1</ambient>  <!-- Blue color -->
          <diffuse>0 0 1 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>

      </visual>
    </link>
    <joint name='right_wheel_joint' type='revolute'>
      <pose relative_to='base_link'>0 -0.175 0 1.5708 -0 0</pose>
      <parent>base_link</parent>
      <child>right_wheel</child>
      <axis>
        <xyz>0 0 -1</xyz>
        <limit>
          <lower>-1e+16</lower>
          <upper>1e+16</upper>
        </limit>
        <dynamics>
          <spring_reference>0</spring_reference>
          <spring_stiffness>0</spring_stiffness>
        </dynamics>
      </axis>
    </joint>
    <link name='right_wheel'>
      <pose relative_to='right_wheel_joint'>0 0 0 0 -0 0</pose>
      <inertial>
        <pose>0 0 0 0 -0 0</pose>
        <mass>0.1</mass>
        <inertia>
          <ixx>7.58333e-05</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>7.58333e-05</iyy>
          <iyz>0</iyz>
          <izz>0.000125</izz>
        </inertia>
      </inertial>
      <collision name='right_wheel_collision'>
        <pose>0 0 0 0 -0 0</pose>
        <geometry>
          <cylinder>
            <length>0.04</length>
            <radius>0.05</radius>
          </cylinder>
        </geometry>
        <surface>
          <contact>
            <ode/>
          </contact>
          <friction>
            <ode/>
          </friction>
        </surface>
      </collision>
      <visual name='right_wheel_visual'>
        <pose>0 0 0 0 -0 0</pose>
        <geometry>
          <cylinder>
            <length>0.04</length>
            <radius>0.05</radius>
          </cylinder>
        </geometry>
        <material>
          <ambient>0 0 1 1</ambient>  <!-- Blue color -->
          <diffuse>0 0 1 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>

      </visual>
    </link>
  </model>
</sdf>
